# .env_deploy.example — copy to .env_deploy and fill in. Never commit .env_deploy.
#   cp .env_deploy.example .env_deploy
#
# deploy.sh is copied unchanged from the Run project (C:\xampp\htdocs\Run).
# This file configures it to upload ONLY the web/ folder of TimSales6.

# ── Connection (required) — same FTP host as the Run project ──
SERVER_USER="ftpuser"
FTP_PASSWORD="secret"
SERVER_IP="ftp.example.com"
APP_DIR="/public_html/timsales"        # remote folder for the TimSales web app

# ── Connection (optional) ───────────────────────────────────
FTP_PORT="21"
FTP_TLS="yes"
FTP_INSECURE="yes"                     # the shared host serves an untrusted certificate
CONNECT_TIMEOUT="20"
MAX_TIME="300"
HEALTH_URL=""                          # e.g. https://example.com/timsales/login.php

# ── What to upload ──────────────────────────────────────────
SOURCE_DIR="web"                       # contents of web/ map onto APP_DIR
# README.md is documentation only. .env / .env.example are always excluded by deploy.sh.
EXCLUDE_LIST="README.md"

# ── Checks ──────────────────────────────────────────────────
PRE_DEPLOY_CMD=""
PHP_LINT="yes"
PHP_BIN="/mnt/c/xampp/php/php.exe"     # XAMPP PHP under WSL (PHP 8.2 — syntax only)
PHP56_CHECK="yes"                      # production host is PHP 5.6: reject ?? and random_bytes
