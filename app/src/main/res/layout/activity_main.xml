<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f8f9fa"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="สถิติยอดขาย"
            android:textSize="16sp"
            android:textColor="#2c3e50"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- Statistics Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Total Amount Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/card_background"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_money"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:tint="#27ae60" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ยอดขายรวม"
                    android:textSize="12sp"
                    android:textColor="#7f8c8d"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="฿0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#27ae60"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Total Weight Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/card_background"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_weight"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:tint="#3498db" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ปริมาณรวม"
                    android:textSize="12sp"
                    android:textColor="#7f8c8d"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTotalKg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0.00 กก."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3498db"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Average Price Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/card_background"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_calculator"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:tint="#e67e22" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ราคาเฉลี่ย"
                    android:textSize="12sp"
                    android:textColor="#7f8c8d"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvAveragePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="฿0.00/กก."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#e67e22"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Count of Sales Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/card_background"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_document_count"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:tint="#9b59b6" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="จำนวนรายการ"
                    android:textSize="12sp"
                    android:textColor="#7f8c8d"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvCountOfSales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 รายการ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#9b59b6"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Error Message -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="เกิดข้อผิดพลาดในการโหลดข้อมูล"
        android:textColor="#e74c3c"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <!-- Add Sales Button -->
        <Button
            android:id="@+id/btnAddSales"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="เพิ่มยอดขาย"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#27ae60"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:drawableStart="@drawable/ic_add_modern"
            android:drawablePadding="12dp"
            android:gravity="center" />

        <!-- View Sales List Button -->
        <Button
            android:id="@+id/btnViewSalesList"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ดูรายการยอดขาย"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#3498db"
            android:textColor="@android:color/white"
            android:elevation="4dp"
            android:drawableStart="@drawable/ic_list_modern"
            android:drawablePadding="12dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Refresh Button - Hidden as per user request -->
    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="รีเฟรช"
        android:textSize="14sp"
        android:backgroundTint="#95a5a6"
        android:textColor="@android:color/white"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:drawableStart="@drawable/ic_refresh_modern"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>