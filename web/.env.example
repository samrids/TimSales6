# ============================================================
# web/.env.example — คัดลอกเป็น web/.env แล้วใส่ค่าจริง
# อ่านฝั่ง server เท่านั้น (app/bootstrap.php) — ไม่ถูกส่งไปที่ browser
# deploy.sh ไม่อัปโหลดไฟล์ .env — ต้องอัปโหลด .env ขึ้น server เองครั้งแรก
# ============================================================

# --- ฐานข้อมูล SQLite ---
# ปล่อยว่าง = ใช้ data/timsales.sqlite (สร้างให้อัตโนมัติ, โฟลเดอร์ data/ ต้องเขียนได้)
# ถ้า host อนุญาต ให้ชี้ไปนอก public_html จะปลอดภัยกว่า เช่น /home/user/timsales-data/timsales.sqlite
DB_PATH=

# --- Login ---
# ปล่อยว่างไว้ครั้งแรก แล้วเปิด login.php เพื่อสร้างค่า hash จากรหัสผ่านที่ต้องการ
# จากนั้นนำบรรทัดที่ได้มาใส่แทนบรรทัดด้านล่าง
APP_PASSWORD_HASH=

# --- JSON API สำหรับแอป Android (api.php) ---
# ปล่อยว่าง = ปิด API. ใส่ค่าสุ่มยาวอย่างน้อย 16 ตัวอักษร เช่นผลจากคำสั่ง
#   php -r "echo bin2hex(openssl_random_pseudo_bytes(24));"
API_TOKEN=
