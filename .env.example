# Environment Variables Template สำหรับ TimSales Application
# สำเนาไฟล์นี้เป็น .env และแก้ไขค่าให้ตรงกับ Grist ของคุณ

# Grist API Configuration
GRIST_BASE_URL=https://docs.getgrist.com/api/
GRIST_DOC_ID=YOUR_DOCUMENT_ID_HERE
GRIST_API_KEY=YOUR_API_KEY_HERE

# Table Names
GRIST_TABLE_ID=TimSales
TIMYEAR_TABLE_ID=TimYear

# วิธีการตั้งค่า:
# 1. คัดลอกไฟล์นี้และเปลี่ยนชื่อเป็น .env
# 2. แทนที่ YOUR_DOCUMENT_ID_HERE ด้วย Document ID จริง
# 3. แทนที่ YOUR_API_KEY_HERE ด้วย API Key จริง
# 4. ปรับแก้ Table names ถ้าจำเป็น